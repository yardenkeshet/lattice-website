# Port the Flask/SocketIO backend listens on.
# Keep react_frontend/.env's VITE_BACKEND_LOCAL_URL in sync with this.
BACKEND_PORT=5003

# Bind address. 0.0.0.0 = reachable from other machines (LAN dev).
# On the public server set this to 127.0.0.1 so only nginx can reach the backend.
# BACKEND_HOST=127.0.0.1
